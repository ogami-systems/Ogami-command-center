# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Google: personal account (its own Google Cloud OAuth client, Desktop app type) ---
GOOGLE_PERSONAL_CLIENT_ID=
GOOGLE_PERSONAL_CLIENT_SECRET=
GOOGLE_PERSONAL_TOKEN_PATH=secrets/personal_google_token.json

# --- Google: Ogami business account (its own Google Cloud OAuth client, Desktop app type) ---
GOOGLE_OGAMI_CLIENT_ID=
GOOGLE_OGAMI_CLIENT_SECRET=
GOOGLE_OGAMI_TOKEN_PATH=secrets/ogami_google_token.json

# --- Spotify (placeholder only — not wired to any tool yet) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Model budget governor ---
MODEL_DAILY_BUDGET_USD=5.00
MAX_ESCALATIONS_PER_RUN=2

# --- Runtime ---
SAINT_ENV=development
SAINT_DB_PATH=data/saint.db
SAINT_LOG_LEVEL=INFO
SAINT_TIMEZONE=America/New_York
